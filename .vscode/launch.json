{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug OW: apply",
      "type": "debugpy",
      "request": "launch",
      "module": "ow",
      "args": ["apply"],
      "console": "integratedTerminal",
      "justMyCode": false,
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Debug OW: status",
      "type": "debugpy",
      "request": "launch",
      "module": "ow",
      "args": ["status"],
      "console": "integratedTerminal",
      "justMyCode": false,
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Debug OW: rebase",
      "type": "debugpy",
      "request": "launch",
      "module": "ow",
      "args": ["rebase"],
      "console": "integratedTerminal",
      "justMyCode": false,
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Debug OW: init",
      "type": "debugpy",
      "request": "launch",
      "module": "ow",
      "args": ["init", "test-ws", "-r", "community:master", "-t", "common"],
      "console": "integratedTerminal",
      "justMyCode": false,
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Debug OW: rm",
      "type": "debugpy",
      "request": "launch",
      "module": "ow",
      "args": ["rm", "test-ws", "-y"],
      "console": "integratedTerminal",
      "justMyCode": false,
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Debug Tests",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["-v", "src/tests/"],
      "console": "integratedTerminal",
      "justMyCode": false,
      "cwd": "${workspaceFolder}"
    }
  ]
}
